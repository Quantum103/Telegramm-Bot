# Локальные параметры проекта. Скопируйте файл в .env и измените пароль БД.
# Telegram-токен здесь пока не нужен: бот будет реализован на следующем этапе.

# PostgreSQL
POSTGRES_DB=bible_platform
POSTGRES_USER=bible_app
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8080
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=bible_platform
DATABASE_USER=bible_app
DATABASE_SSLMODE=disable
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1

# Frontend
FRONTEND_PORT=8081
# Пустое значение использует same-origin proxy в Nginx / Vite.
VITE_API_BASE_URL=

# Пока не используется backend: переменная понадобится на этапе Telegram-бота.
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
