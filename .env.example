# Локальные параметры проекта. Скопируйте файл в .env и задайте свой пароль БД.
# Создайте бота через @BotFather и добавьте полученный токен в TELEGRAM_BOT_TOKEN ниже.

# PostgreSQL
POSTGRES_DB=bible_platform
POSTGRES_USER=bible_app
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

# При необходимости можно задать полный URI для инструмента миграций.
# Используйте URL-кодирование символов пароля, зарезервированных в URI.
# Пустое значение формирует URI из POSTGRES_USER, POSTGRES_PASSWORD и POSTGRES_DB.
MIGRATIONS_DATABASE_URL=

# Порты, публикуемые на localhost
BACKEND_PORT=8080
FRONTEND_PORT=8081

# Тайм-ауты HTTP-сервера
HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# Параметры для отдельного запуска backend вне Docker Compose.
# В Compose host, port, database, user и password собираются из POSTGRES_*.
HTTP_ADDR=:8080
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=bible_platform
DATABASE_USER=bible_app
DATABASE_PASSWORD=change-this-local-password
DATABASE_SSLMODE=disable
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1

# Пустое значение отключает Telegram-бота, не влияя на HTTP API.
# Запишите сюда токен, который выдал официальный @BotFather. Не публикуйте его.
TELEGRAM_BOT_TOKEN=

# Пустое значение использует same-origin proxy в Nginx / Vite.
VITE_API_BASE_URL=
